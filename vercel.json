{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Expose-Headers",
          "value": "PAYMENT-REQUIRED, PAYMENT-RESPONSE"
        }
      ]
    }
  ],
  "functions": {
    "index.js": {
      "includeFiles": "{src,generated,public,private}/**"
    }
  }
}
