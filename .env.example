# Public receive wallet only — NEVER put a private key here
PAY_TO=0x96873Fb532C630aE88c5e8A5dF5ef430c92dfF32

# Base mainnet (production). Use eip155:84532 for Base Sepolia test.
NETWORK=eip155:8453

# Circle USDC on Base mainnet (auto-selected from NETWORK if unset)
USDC_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Prefer CDP for mainnet. Alternative: https://facilitator.payai.network
# Do NOT use https://x402.org/facilitator on mainnet.
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_PROVIDER=cdp

# CDP API keys (from https://portal.cdp.coinbase.com) — required when STUB_MODE=0 + CDP
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# 1 = safe demo (stub-ok signature, no chain). 0 = live verify/settle via facilitator.
STUB_MODE=1

# Keep false until Nathaniel publishes (no Bazaar / no fake GMV)
LISTED=false

PORT=4021

# Optional: attach official @x402/express middleware when STUB_MODE=0
# USE_X402_MIDDLEWARE=1
# USE_CDP_X402_SERVER=1
