{
  "name": "defifintechdirectory-x402-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "AV-Hub x402 gateway — Base USDC exact payments for 5 MVP tools. listed:false until publish.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check.mjs",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "capability:new": "node scripts/factory.mjs new",
    "capability:validate": "node scripts/factory.mjs validate",
    "capability:test": "npm test",
    "discovery:build": "node scripts/factory.mjs discovery"
  },
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ajv": "8.17.1",
    "@modelcontextprotocol/sdk": "https://registry.npmjs.org/@modelcontextprotocol/sdk/-/sdk-1.26.0.tgz"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  }
}
